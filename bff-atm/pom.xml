<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.bancoxyz</groupId>
    <artifactId>bff-atm</artifactId>
    <version>1.0.0</version>
    <name>bff-atm</name>
    <description>
        Backend for Frontend optimizado para el canal de CAJEROS AUTOMATICOS del Banco XYZ:
        interfaz minima y segura, restringida a las dos operaciones criticas que un cajero
        realmente ofrece (consulta de saldo y retiro de efectivo).
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            A diferencia de bff-web y bff-mobile, este modulo NO depende de jjwt: la sesion de
            cajero es deliberadamente mas simple que un JWT (un token opaco de un solo uso,
            valido 2 minutos, invalidado automaticamente tras un retiro exitoso - ver
            SesionAtmService). Un cajero automatico no necesita portar claims reutilizables
            entre servicios, solo demostrar que el PIN se valido hace unos segundos.
        -->
    </dependencies>

    <build>
        <finalName>bff-atm</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
